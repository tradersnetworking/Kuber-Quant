# =============================================================================
# Kuber Quant — Environment Variables
# Copy to .env and fill in production values
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kuber
# Optional read replica for reporting/dashboard queries
# DATABASE_READ_URL=postgresql://postgres:postgres@127.0.0.1:5432/kuber

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-string-at-least-32-characters-long
ENCRYPTION_KEY=change-this-to-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
WEB_PORT=3000
API_PORT=8080
BASE_PATH=/
APP_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:8080
# Create/sync demo accounts on startup (true=reset passwords, false=disable, unset=auto)
# Production: set BOOTSTRAP_USERS=false after initial admin setup
# BOOTSTRAP_USERS=true
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
WEB_DIST=./artifacts/trading-platform/dist/public
UPLOAD_DIR=./uploads

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Production default: 1500 req / 15 min per IP. Dev: disabled unless RATE_LIMIT_ENABLE=true
RATE_LIMIT_MAX=1500
RATE_LIMIT_ENABLE=
AUTH_RATE_LIMIT_MAX=20

# ── SMTP (Hostinger) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
SMTP_FROM=Kuber Quant <noreply@yourdomain.com>

# ── Support inbox IMAP (optional — sync inbound support emails) ───────────────
# SUPPORT_IMAP_ENABLED=true
# SUPPORT_IMAP_HOST=imap.hostinger.com
# SUPPORT_IMAP_PORT=993
# SUPPORT_IMAP_SECURE=true
# SUPPORT_IMAP_USER=support@yourdomain.com
# SUPPORT_IMAP_PASS=your-email-password

# ── AI auto-replies (optional — personalized ticket acknowledgment emails) ───
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

# ── Document OCR (KYC / deposit proof validation via OpenAI vision) ───────────
# DOCUMENT_OCR_ENABLED=true

# ── Partner integrations (scoped API keys + outbound webhooks) ────────────────
# PARTNER_WEBHOOKS_ENABLED=true

# ── Geo-blocking (ISO 3166-1 alpha-2 codes, requires CF-IPCountry or X-Country-Code) ─
# BLOCKED_COUNTRY_CODES=CN,RU,KP

# ── Razorpay ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── PhonePe ────────────────────────────────────────────────────────────────────
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# ── PayPal ─────────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── PayU ───────────────────────────────────────────────────────────────────────
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=test

# ── Crypto (admin configures wallet addresses in admin panel) ──────────────────
# Blockchain verification uses admin approval flow for deposits

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=

# ── Hostinger VPS deploy (scripts/deploy-hostinger.mjs) ───────────────────────
# HOSTINGER_API_KEY=          # hPanel → Profile → API
# HOSTINGER_VM_ID=            # from srv123456.hstgr.cloud → 123456

# ── Docker production (see .env.docker.example + DEPLOYMENT-DOCKER.md) ────────
# REDIS_URL=redis://:password@redis:6379

# ── n8n automation (optional — POST JSON events to your n8n webhook) ───────────
# N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/kuber-quant
# N8N_WEBHOOK_SECRET=your-hmac-secret
# N8N_WEBHOOK_ENABLED=true

# ── Sentry error tracking (optional) ───────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_RELEASE=kuber-quant@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENABLE=true
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=kuber-quant@1.0.0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_ENABLE=true

# ── Automated backups (requires pg_dump on PATH) ───────────────────────────────
# BACKUP_DIR=/var/backups/kuber-quant
# SERVE_SPA=false             # set automatically in Docker backend

# ── Redis (required for BullMQ worker + distributed rate limits) ───────────────
# REDIS_URL=redis://:password@127.0.0.1:6379
# RUN_JOBS_INLINE=true        # force inline crons when Redis is set (dev only)
# WORKER_MODE=true            # run worker.ts instead of API (separate process)
# WORKER_CONCURRENCY=2
# ASYNC_EMAIL=true            # queue transactional emails via BullMQ when Redis is set

# ── S3-compatible object storage (optional — Cloudflare R2, AWS S3, MinIO) ─────
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=                # e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=           # CDN/public bucket URL for branding & profile images
# S3_FORCE_PATH_STYLE=false     # set true for MinIO
# S3_KEY_PREFIX=uploads

# ── AML screening provider ─────────────────────────────────────────────────────
# AML_PROVIDER=local            # local | sumsub
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_BASE_URL=https://api.sumsub.com
# SUMSUB_LEVEL_NAME=basic-kyc-level

# ── SIEM / log export (optional — Datadog, Splunk HTTP collector, etc.) ────────
# SIEM_WEBHOOK_URL=
# SIEM_WEBHOOK_SECRET=
# SIEM_EXPORT_ENABLED=true

# ── Cookies ────────────────────────────────────────────────────────────────────
# COOKIE_SECURE=true           # force Secure flag on trusted-device cookie (auto in production)

# ── SIEM / security event export (optional) ────────────────────────────────────
# SIEM_WEBHOOK_URL=https://your-siem.example.com/ingest/kuber-quant
# SIEM_WEBHOOK_SECRET=your-hmac-secret
# SIEM_EXPORT_ENABLED=true

# ── Read replica (optional — reporting/dashboard queries) ───────────────────────
# DATABASE_READ_URL=postgresql://reader:password@replica-host:5432/kuber
