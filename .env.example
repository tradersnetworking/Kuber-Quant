# =============================================================================
# Kuber Quant — Environment Variables
# Copy to .env and fill in production values
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kuber

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-string-at-least-32-characters-long
ENCRYPTION_KEY=change-this-to-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
WEB_PORT=3000
API_PORT=8080
BASE_PATH=/
APP_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:8080
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
WEB_DIST=./artifacts/trading-platform/dist/public
UPLOAD_DIR=./uploads

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── SMTP (Hostinger) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
SMTP_FROM=Kuber Quant <noreply@yourdomain.com>

# ── Razorpay ───────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── PhonePe ────────────────────────────────────────────────────────────────────
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# ── PayPal ─────────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ── PayU ───────────────────────────────────────────────────────────────────────
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=test

# ── Crypto (admin configures wallet addresses in admin panel) ──────────────────
# Blockchain verification uses admin approval flow for deposits

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=

# ── Hostinger VPS deploy (scripts/deploy-hostinger.mjs) ───────────────────────
# HOSTINGER_API_KEY=          # hPanel → Profile → API
# HOSTINGER_VM_ID=            # from srv123456.hstgr.cloud → 123456

# ── Docker production (see .env.docker.example + DEPLOYMENT-DOCKER.md) ────────
# REDIS_URL=redis://:password@redis:6379
# SERVE_SPA=false             # set automatically in Docker backend
