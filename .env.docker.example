# =============================================================================
# Kuber Quant — Docker production environment (Ubuntu 24 / Hostinger VPS)
# Copy to .env:  cp .env.docker.example .env
# =============================================================================

# ── Public URLs (your domain) ─────────────────────────────────────────────────
APP_URL=https://yourdomain.com
API_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ── PostgreSQL (Docker service: postgres) ─────────────────────────────────────
POSTGRES_USER=kuber
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=kuber

# ── Redis (Docker service: redis) ─────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password

# ── Auth / encryption (min 32 characters each) ────────────────────────────────
SESSION_SECRET=change-this-to-a-random-string-at-least-32-characters-long
ENCRYPTION_KEY=change-this-to-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# First boot: set true once to create demo admin accounts, then set false
BOOTSTRAP_USERS=false

# ── SSL (optional — mount certs to docker/nginx/ssl/) ─────────────────────────
ENABLE_SSL=false
HTTP_PORT=80
HTTPS_PORT=443

# ── Frontend build args ───────────────────────────────────────────────────────
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# WebAuthn / Passkeys — set RP ID to your domain hostname (no https://)
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_ORIGIN=https://yourdomain.com
WEBAUTHN_RP_NAME=Kuber Quant

# ── PM2 (backend container) ───────────────────────────────────────────────────
PM2_INSTANCES=1
PM2_MAX_MEMORY=768M
PM2_WORKER_MAX_MEMORY=512M
WORKER_CONCURRENCY=2
ASYNC_EMAIL=true

# ── S3-compatible uploads (optional — R2 / AWS / MinIO) ───────────────────────
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# S3_FORCE_PATH_STYLE=false
# S3_KEY_PREFIX=uploads

# ── AML provider (optional — Sumsub) ──────────────────────────────────────────
# AML_PROVIDER=local
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_BASE_URL=https://api.sumsub.com
# SUMSUB_LEVEL_NAME=basic-kyc-level

# ── SIEM export (optional) ─────────────────────────────────────────────────────
# SIEM_WEBHOOK_URL=
# SIEM_WEBHOOK_SECRET=
# SIEM_EXPORT_ENABLED=true

# ── Read replica (optional) ────────────────────────────────────────────────────
# DATABASE_READ_URL=

# ── SMTP (Hostinger email) ────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-email-password
SMTP_FROM=Kuber Quant <noreply@yourdomain.com>

# ── Support inbox IMAP (optional — same Hostinger mailbox as SMTP) ───────────
SUPPORT_IMAP_ENABLED=true
SUPPORT_IMAP_HOST=imap.hostinger.com
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_SECURE=true
SUPPORT_IMAP_USER=support@yourdomain.com
SUPPORT_IMAP_PASS=your-email-password

# ── Payment gateways ──────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=prod

# ── Hostinger VPS GitHub deploy (optional) ────────────────────────────────────
# HOSTINGER_API_KEY=
# HOSTINGER_VM_ID=
