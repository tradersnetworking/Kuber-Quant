# Import this file in hPanel → Node.js App → Environment Variables → Import .env
# REQUIRED: replace DATABASE_URL with your Supabase PostgreSQL connection string.
# The Express app reads DATABASE_URL only — do NOT set SUPABASE_URL or SUPABASE_API_KEY.
# URL-encode special characters in the password (@ → %40, # → %23)
#
# Direct (port 5432):
#   postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.<project-ref>.supabase.co:5432/postgres
# Pooler — Singapore ap-southeast-1 (if direct fails from Hostinger):
#   postgresql://postgres.<project-ref>:YOUR_URL_ENCODED_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Example project ref: pskrqbrlzbnwtaolpbkx → db.pskrqbrlzbnwtaolpbkx.supabase.co
# Do NOT set PORT — Hostinger assigns it automatically

NODE_ENV=production
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.pskrqbrlzbnwtaolpbkx.supabase.co:5432/postgres
SESSION_SECRET=KuberQuantProdSessionSecret2026Min32Chars
ENCRYPTION_KEY=KuberQuantProdEncryptionKey2026Min32Ch
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
APP_URL=https://kuberquant.com
API_URL=https://kuberquant.com
CORS_ORIGINS=https://kuberquant.com,https://www.kuberquant.com,https://kuberquant.in,https://www.kuberquant.in
WEBAUTHN_RP_ID=kuberquant.com
WEBAUTHN_ORIGIN=https://kuberquant.com
WEBAUTHN_RP_NAME=Kuber Quant
BOOTSTRAP_USERS=true
WEB_DIST=./artifacts/trading-platform/dist/public
UPLOAD_DIR=./uploads
BASE_PATH=/
RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=20
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@kuberquant.com
SMTP_PASS=YOUR_EMAIL_PASSWORD
SMTP_FROM=hello@kuberquant.com
