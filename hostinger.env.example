# Import this file in hPanel → Node.js App → Environment Variables → Import .env
# REQUIRED: replace DATABASE_URL with your Neon PostgreSQL connection string
# Do NOT set PORT — Hostinger assigns it automatically

NODE_ENV=production
DATABASE_URL=REPLACE_WITH_NEON_POSTGRESQL_URL
SESSION_SECRET=KuberQuantProdSessionSecret2026Min32Chars
ENCRYPTION_KEY=KuberQuantProdEncryptionKey2026Min32Ch
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
APP_URL=https://kuberquant.com
API_URL=https://kuberquant.com
CORS_ORIGINS=https://kuberquant.com,https://www.kuberquant.com,https://kuberquant.in,https://www.kuberquant.in
WEBAUTHN_RP_ID=kuberquant.com
WEBAUTHN_ORIGIN=https://kuberquant.com
WEBAUTHN_RP_NAME=Kuber Quant
BOOTSTRAP_USERS=true
WEB_DIST=./artifacts/trading-platform/dist/public
UPLOAD_DIR=./uploads
BASE_PATH=/
RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=20
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@kuberquant.com
SMTP_PASS=YOUR_EMAIL_PASSWORD
SMTP_FROM=hello@kuberquant.com
