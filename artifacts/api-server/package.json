    "@sentry/node": "^10.54.0",
    "@simplewebauthn/server": "^13.3.1",
    "@swc/helpers": "^0.5.21",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.3",
    "cookie-parser": "^1.4.7",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "imapflow": "^1.0.189",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.7.2",
