    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.8",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
