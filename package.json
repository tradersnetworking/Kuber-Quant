{
  "name": "kuber-quant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,amber \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/trading-platform run dev",
    "build": "node scripts/hostinger-build.mjs",
    "hostinger:install": "node scripts/hostinger-install.mjs",
    "hostinger:build": "node scripts/hostinger-build.mjs",
    "build:check": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:push": "pnpm --filter @workspace/db run push-force",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:seed": "pnpm exec tsx --env-file=.env scripts/src/seed.ts",
    "test": "pnpm exec tsx --test scripts/src/*.test.ts",
    "build:web": "pnpm --filter @workspace/trading-platform run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:prod": "pnpm build:web && pnpm build:api",
    "start": "node server.js",
    "start:prod": "node --env-file=.env server.js",
    "deploy:hostinger": "node --env-file=.env scripts/deploy-hostinger.mjs"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
